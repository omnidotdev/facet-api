# =============================================================================
# Facet API - AI generation gateway
#
# The service boots with NO variables set: the managed generation path simply
# disables itself and BYOK requests keep working. Set the Synapse provisioning
# variables below to enable the managed path.
# =============================================================================

# --- AI gateway (managed path) ------------------------------------------------

# Synapse AI router base URL (no trailing slash needed)
# Optional, defaults to http://localhost:6000
SYNAPSE_BASE_URL="http://localhost:6000"

# Product-scoped managed keys. REQUIRED (both) to enable managed generation:
# each managed call provisions a per-user Synapse key scoped to the facet
# Aether app and billed to the user's pooled credit balance, so the gateway
# checks credits (402 when empty), meters, and debits. There is no shared
# managed key: when either is unset, or provisioning fails, the managed path
# returns 503 while BYOK still works.
# SYNAPSE_API_URL is the provisioning API (api.synapse), NOT the gateway above.
# NEVER expose the secret to the browser (never VITE_-prefixed, never in a response)
SYNAPSE_API_URL=""
SYNAPSE_GATEWAY_SECRET=""

# Model sent to Synapse. Optional, defaults to "auto" (Synapse smart routing:
# the gateway picks the best/cheapest model per request). Set a Synapse virtual
# model (auto/best/fast/cheap) or a concrete provider-prefixed id
# (e.g. anthropic/claude-opus-4-6) for maximum quality. Bare ids like
# "claude-sonnet-5-5" are rejected by the gateway
FACET_AI_MODEL="auto"

# Concrete model used if the gateway refuses a virtual/routed FACET_AI_MODEL
# (this key is not entitled for smart routing, or the id is unknown), so routing
# can never break generation. Optional, provider-prefixed
FACET_AI_FALLBACK_MODEL="anthropic/claude-sonnet-4-5-20250929"

# --- Cost controls (all optional, sensible defaults) --------------------------

# Max accepted prompt length in characters (default 2000)
MAX_PROMPT_CHARS="2000"

# Max output tokens requested from the model (default 2048)
MAX_OUTPUT_TOKENS="2048"

# Synapse request timeout in milliseconds (default 30000)
AI_REQUEST_TIMEOUT_MS="30000"

# Max repair attempts honored per logical generation (default 2)
MAX_REPAIR_ATTEMPTS="2"

# Free-tier managed spend ceiling per UTC day in real US cents (default 500).
# A backstop against free-tier abuse; paid tiers are bounded by their own
# credit balance and are never blocked by it
DAILY_SPEND_CEILING_CENTS="500"

# Per-IP sliding-window rate limit (defaults: 60000ms window, 20 requests)
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="20"

# Limited-preview allowlist for the managed path: comma-separated
# Omni user ids. When set, ONLY these users can use managed generation;
# every other signed-in user is refused the managed path and must use their own
# key (BYOK). Leave empty for no restriction. Set this in prod (ideally from a
# secret) to cap who can run up managed spend; the ids live only here, never in
# code or git
FACET_MANAGED_ALLOWLIST=""

# --- Managed path auth + breaker (required for the managed path) --------------

# Gatekeeper base URL used to verify the managed path's bearer token.
# A signed-in Omni user sends Authorization: Bearer <token>; the token is
# resolved via this URL's JWKS/userinfo. BYOK needs none of this
AUTH_BASE_URL="https://localhost:8000"

# Postgres connection for the free-tier daily spend breaker (the daily_spend
# table). The managed path needs it; BYOK does not
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/facet-api?schema=public"

# --- Billing / entitlements (Aether) ------------------------------------------

# Aether billing service base URL. Optional: when set, the user's tier (the
# facet "tier" entitlement, which decides whether the free-tier breaker applies)
# and their pooled credit balance (shown by /capabilities) come from Aether.
# When unset the service warns, everyone reads as free tier, and no balance is
# shown. Credits themselves are always enforced by the Synapse gateway
# BILLING_BASE_URL="https://localhost:7000"

# Aether service API key (sent as x-service-api-key). Required alongside
# BILLING_BASE_URL for the credit balance read; a secret, never VITE_-prefixed
# BILLING_SERVICE_API_KEY=""

# Shared secret for verifying Aether billing webhook signatures (HMAC-SHA256).
# Optional: when unset the webhook that invalidates the cached tier still
# mounts but skips signature verification and logs a warning
# BILLING_WEBHOOK_SECRET=""

# --- Scaffolding (not used by the AI gateway) ---------------------------------

# GraphQL - https://escape.tech/graphql-armor/docs/plugins/cost-limit
# GRAPHQL_MAX_COMPLEXITY_COST="400"

# Allowed origins for CORS (comma-separated), e.g. the facet-app dev origin
CORS_ALLOWED_ORIGINS="https://localhost:3000"

# Vortex (event streaming)
# VORTEX_API_URL="https://localhost:5000"
# VORTEX_API_KEY=""
